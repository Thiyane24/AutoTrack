# Copy this file to .env and fill in your real values.
# Never commit .env to version control. It is already in .gitignore.

# ─────────────────────────────────────────
# Gmail credentials (used for BOTH IMAP fetch AND SMTP notify)
# ─────────────────────────────────────────
# Use a Google App Password, NOT your account password.
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: override the SMTP server. Defaults to Gmail's.
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587

# Optional: where notification emails are delivered. Defaults to
# GMAIL_ADDRESS when unset, which means your inbox notifies itself.
# Set this to a different address (e.g. an alias) if you want the
# notifications routed elsewhere.
# NOTIFY_RECIPIENT_EMAIL=

# ─────────────────────────────────────────
# Pipeline tuning (all optional)
# ─────────────────────────────────────────
# DuckDB file path (default: /opt/airflow/data/autotrack.duckdb)
DUCKDB_PATH=
# Parquet handoff path between Airflow tasks
AUTOTRACK_HANDOFF_PATH=
# Fallback JSONL log path when Gmail notify creds are missing
AUTOTRACK_NOTIFY_LOG=
# Max notifications to send per run (default 50)
AUTOTRACK_NOTIFY_MAX_PER_RUN=50
# Number of SMTP retries on transient errors (default 3)
AUTOTRACK_NOTIFY_MAX_ATTEMPTS=3
# Exponential-backoff base for SMTP retries in seconds (default 2.0)
AUTOTRACK_NOTIFY_BACKOFF_BASE=2.0
# IMAP connection timeout in seconds (default 30)
AUTOTRACK_IMAP_TIMEOUT=30
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
