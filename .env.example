# Copy this file to .env and fill in your real values.
# Never commit .env to version control. It is already in .gitignore.

# ─────────────────────────────────────────
# Gmail (IMAP) credentials
# ─────────────────────────────────────────
# Use a Google App Password, NOT your account password.
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ─────────────────────────────────────────
# Meta WhatsApp Cloud API credentials
# ─────────────────────────────────────────
# Get these from https://developers.facebook.com/apps/ → WhatsApp → API Setup
META_ACCESS_TOKEN=
PHONE_NUMBER_ID=
DESTINATION_PHONE=
# Optional: pin the Graph API version (default v20.0)
META_API_VERSION=v20.0

# ─────────────────────────────────────────
# Pipeline tuning (all optional)
# ─────────────────────────────────────────
# DuckDB file path (default: /opt/airflow/data/autotrack.duckdb)
DUCKDB_PATH=
# Parquet handoff path between Airflow tasks
AUTOTRACK_HANDOFF_PATH=
# Fallback JSONL log path when Meta creds are missing
AUTOTRACK_NOTIFY_LOG=
# Max messages to send per notify run (default 50)
AUTOTRACK_NOTIFY_MAX_PER_RUN=50
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
